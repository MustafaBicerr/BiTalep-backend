# Copy to .env — never commit secrets.

POSTGRES_DB=bitalep
POSTGRES_USER=bitalep
POSTGRES_PASSWORD=change-me-local

SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/bitalep
SPRING_DATASOURCE_USERNAME=bitalep
SPRING_DATASOURCE_PASSWORD=change-me-local

JWT_SECRET=change-me-to-a-64-char-random-string-for-hs256-signing-key!!
BILLING_ENFORCEMENT=false
FILE_MAX_BYTES=10485760
FILE_STORAGE_PATH=/data/files
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081,https://panel.bitalep.com.tr
PANEL_BASE_URL=http://localhost:5173
AUTH_RATE_LIMIT=60

# SMTP — local Mailpit (compose service mailpit:1025). Prod: real transactional SMTP.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=BiTalep <noreply@bitalep.com.tr>
MAIL_STARTTLS=false

# Host publish for API (prod uses 127.0.0.1:18xxx — see docs/PROD_PORTS.md after SUB-B18)
API_HOST_PORT=8080
PANEL_HOST_PORT=8081
MAILPIT_UI_PORT=8025
